{
  "version": "0.1.0",
  "workflows": [
    {
      "id": "classify-project",
      "name": "Classify Project",
      "phase": "classify",
      "modes": ["pending", "light", "standard", "full"],
      "purpose": "Determine Light, Standard, or Full rigor before planning or implementation.",
      "required_inputs": ["project brief", "user ambition", "risk triggers"],
      "produces": [".codex-brain/classification.json", ".codex-brain/state.json"],
      "allowed_actions": ["ask targeted classification questions", "recommend mode", "record user approval"],
      "blocked_actions": ["write product code", "create database migrations", "build frontend UI"],
      "approval_required": true,
      "escalation_triggers": ["multi-tenancy", "payments", "regulated domain", "AI-core", "enterprise", "GDPR", "unicorn ambition"],
      "next": ["validate-idea", "quick-flow"]
    },
    {
      "id": "validate-idea",
      "name": "Validate Idea",
      "phase": "validate",
      "modes": ["light", "standard", "full"],
      "purpose": "Decide whether the product should be built, pivoted, or stopped.",
      "required_inputs": [".codex-brain/classification.json", "problem statement", "target user"],
      "produces": [".codex-brain/validation.md"],
      "allowed_actions": ["define user", "define value proposition", "run pre-mortem", "record go/conditional-go/pivot/no-go"],
      "blocked_actions": ["lock architecture", "write implementation code"],
      "approval_required": true,
      "escalation_triggers": ["unclear buyer", "weak pain", "no differentiation", "unvalidated compliance risk"],
      "next": ["deep-research", "build-plan", "quick-flow"]
    },
    {
      "id": "quick-flow",
      "name": "Quick Flow",
      "phase": "execute",
      "modes": ["light"],
      "purpose": "Safely implement low-risk changes with a concise spec, one vertical slice, verification, and learning.",
      "required_inputs": ["approved Light mode", "low-risk intent", "Design DNA if UI exists"],
      "produces": ["docs/prd/quick-spec-[slug].md", ".codex-brain/task-records/", ".codex-brain/memory/progress.md"],
      "allowed_actions": ["clarify intent", "write quick spec", "implement one slice", "run checks", "capture lesson"],
      "blocked_actions": ["multi-tenant work", "payment work", "regulated work", "frontend work without Design DNA", "large architecture changes"],
      "approval_required": false,
      "escalation_triggers": ["user data", "auth", "payments", "GDPR", "AI-core", "enterprise", "large scope"],
      "next": ["learn"]
    },
    {
      "id": "deep-research",
      "name": "Deep Research",
      "phase": "research",
      "modes": ["standard", "full"],
      "purpose": "Collect evidence for product, market, technical, design, data, security, privacy, scale, and operating decisions.",
      "required_inputs": [".codex-brain/validation.md", "approved mode"],
      "produces": [".codex-brain/research/", "templates/full/evidence-ledger.template.json"],
      "allowed_actions": ["research competitors", "evaluate stack", "analyze database scale", "analyze security/GDPR", "collect design references"],
      "blocked_actions": ["write Build Plan without evidence", "skip required Full-mode domains"],
      "approval_required": false,
      "escalation_triggers": ["missing competitor analysis", "missing GDPR analysis", "missing database rationale", "missing Design DNA references"],
      "next": ["build-plan"]
    },
    {
      "id": "build-plan",
      "name": "Build Plan",
      "phase": "plan",
      "modes": ["standard", "full"],
      "purpose": "Turn evidence into product, architecture, database, security, privacy, test, launch, and delivery decisions.",
      "required_inputs": [".codex-brain/research/", "evidence ledger"],
      "produces": ["docs/build-plan.md", "docs/adr/"],
      "allowed_actions": ["write architecture", "write database ADR", "write auth model", "write test strategy", "write launch plan"],
      "blocked_actions": ["application implementation", "PRD decomposition before P0/P1 plan gaps are resolved"],
      "approval_required": true,
      "escalation_triggers": ["major decision without ADR", "database without scale model", "AI-core without eval plan", "paid product without billing edge cases"],
      "next": ["design-dna", "decompose"]
    },
    {
      "id": "design-dna",
      "name": "Design DNA",
      "phase": "design-dna",
      "modes": ["light", "standard", "full"],
      "purpose": "Capture and approve visual direction before frontend implementation.",
      "required_inputs": ["UI requirement", "references or screenshots", "user taste direction"],
      "produces": ["design/design-dna.md", "design/tokens.json"],
      "allowed_actions": ["collect references", "define palette", "define typography", "define component style", "define motion", "approve frontend direction"],
      "blocked_actions": ["frontend implementation", "styling", "animations", "marketing UI"],
      "approval_required": true,
      "escalation_triggers": ["generic AI UI risk", "missing references", "accessibility baseline missing"],
      "next": ["decompose", "execute"]
    },
    {
      "id": "decompose",
      "name": "Decompose Into PRDs",
      "phase": "decompose",
      "modes": ["standard", "full"],
      "purpose": "Convert the Build Plan into vertical-slice PRDs with atomic tasks and verifiable acceptance criteria.",
      "required_inputs": ["docs/build-plan.md", "Design DNA if UI exists"],
      "produces": ["docs/prd/", "docs/plans/"],
      "allowed_actions": ["write PRDs", "split vertical slices", "map tests", "run promise-to-spec audit"],
      "blocked_actions": ["giant tasks", "tasks without verification", "execution before decomposition approval"],
      "approval_required": true,
      "escalation_triggers": ["more than one independent user goal", "unverifiable tasks", "missing security/privacy/database tasks"],
      "next": ["execute-task"]
    },
    {
      "id": "execute-task",
      "name": "Execute Task",
      "phase": "execute",
      "modes": ["light", "standard", "full"],
      "purpose": "Implement one focused task or vertical slice, run checks, update state, and capture lessons.",
      "required_inputs": ["current PRD or quick spec", "next unchecked task", "verification command"],
      "produces": ["code changes", ".codex-brain/task-records/", ".codex-brain/memory/progress.md"],
      "allowed_actions": ["edit scoped files", "run verification", "update task status", "capture task record"],
      "blocked_actions": ["unrelated refactors", "marking complete without verification", "ignoring failed checks"],
      "approval_required": false,
      "escalation_triggers": ["test failure after repeated attempts", "scope creep", "dirty worktree conflict", "security/privacy blocker"],
      "next": ["execute-task", "review"]
    },
    {
      "id": "review",
      "name": "Review",
      "phase": "review",
      "modes": ["light", "standard", "full"],
      "purpose": "Review product correctness, code, security, privacy, accessibility, performance, architecture, and test coverage.",
      "required_inputs": ["implemented PRD", "passing checks", "review scope"],
      "produces": ["reviews/", "test traceability updates"],
      "allowed_actions": ["code review", "security review", "privacy review", "accessibility review", "performance review", "architecture review"],
      "blocked_actions": ["shipping with unresolved P0/P1 findings"],
      "approval_required": true,
      "escalation_triggers": ["critical issue", "missing tenant isolation test", "missing GDPR evidence", "visual QA mismatch"],
      "next": ["ship", "execute-task"]
    },
    {
      "id": "ship",
      "name": "Ship",
      "phase": "ship",
      "modes": ["light", "standard", "full"],
      "purpose": "Launch with monitoring, rollback, smoke tests, approval, and incident path.",
      "required_inputs": ["reviews/", "passing checks", "monitoring plan", "rollback plan"],
      "produces": ["docs/ship/launch-plan.md", "docs/ship/rollback-plan.md", "docs/ship/monitoring-plan.md"],
      "allowed_actions": ["deploy", "run smoke tests", "verify monitoring", "record launch decision"],
      "blocked_actions": ["launch without rollback", "launch without monitoring", "launch with critical findings"],
      "approval_required": true,
      "escalation_triggers": ["no smoke test", "no rollback", "no owner for incident response"],
      "next": ["learn"]
    },
    {
      "id": "learn",
      "name": "Learn",
      "phase": "learn",
      "modes": ["light", "standard", "full"],
      "purpose": "Capture project lessons and decide whether to promote them into the brain.",
      "required_inputs": ["completed work", "task records", "review findings", "postmortem if applicable"],
      "produces": [".codex-brain/lessons/", ".codex-brain/memory/progress.md", "postmortems/"],
      "allowed_actions": ["capture lesson", "promote lesson", "update framework/template/schema/script/agent"],
      "blocked_actions": ["ending project without lesson capture"],
      "approval_required": false,
      "escalation_triggers": ["repeated failure", "missed gate", "security/privacy/design/test issue found late"],
      "next": ["classify-project"]
    }
  ]
}

