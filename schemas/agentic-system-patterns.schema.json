{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-brain.local/schemas/agentic-system-patterns.schema.json",
  "title": "Codex Brain Agentic System Patterns",
  "type": "object",
  "required": ["version", "principle", "maturity_levels", "dimensions", "domain_patterns"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "principle": { "type": "string", "minLength": 1 },
    "maturity_levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "signals", "requires", "avoid"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "signals": { "type": "array", "items": { "type": "string" } },
          "requires": { "type": "array", "items": { "type": "string" } },
          "avoid": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "questions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "questions": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "domain_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "keywords", "recommended_level", "highest_level", "first_closed_loop", "memory", "tools", "routines", "evals"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "recommended_level": { "type": "string", "minLength": 1 },
          "highest_level": { "type": "string", "minLength": 1 },
          "first_closed_loop": { "type": "string", "minLength": 1 },
          "memory": { "type": "array", "items": { "type": "string" } },
          "tools": { "type": "array", "items": { "type": "string" } },
          "routines": { "type": "array", "items": { "type": "string" } },
          "evals": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
