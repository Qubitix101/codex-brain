{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-brain.local/schemas/tool-surface-routing-matrix.schema.json",
  "title": "Codex Brain Tool Surface Routing Matrix",
  "type": "object",
  "required": ["version", "principle", "surfaces", "rules"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "principle": { "type": "string", "minLength": 1 },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "best_for", "avoid_for"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "best_for": { "type": "array", "items": { "type": "string" } },
          "avoid_for": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "decision_order": { "type": "array", "items": { "type": "string" } },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "keywords", "preferred_surface", "why"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "preferred_surface": { "type": "string", "minLength": 1 },
          "specific_tool": { "type": "string" },
          "alternates": { "type": "array", "items": { "type": "string" } },
          "why": { "type": "string", "minLength": 1 },
          "verify_with": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
