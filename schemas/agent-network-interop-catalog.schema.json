{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-brain.local/schemas/agent-network-interop-catalog.schema.json",
  "title": "Codex Brain Agent Network Interoperability Catalog",
  "type": "object",
  "required": ["version", "principle", "network_components", "network_patterns"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "principle": { "type": "string", "minLength": 1 },
    "network_components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/network_component" }
    },
    "network_patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/network_pattern" }
    }
  },
  "$defs": {
    "network_component": {
      "type": "object",
      "required": ["id", "name", "purpose", "keywords", "required_outputs", "p0_blockers"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_outputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "p0_blockers": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "network_pattern": {
      "type": "object",
      "required": ["id", "name", "keywords", "recommended_components", "first_interoperable_slice"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommended_components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "first_interoperable_slice": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
