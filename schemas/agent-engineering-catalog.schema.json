{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-brain.local/schemas/agent-engineering-catalog.schema.json",
  "title": "Codex Brain Agent Engineering Catalog",
  "type": "object",
  "required": ["version", "principle", "disciplines", "skill_trust_levels", "skill_archetypes", "domain_skill_patterns"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "principle": { "type": "string", "minLength": 1 },
    "disciplines": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "signals", "required_outputs", "p0_blockers"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "signals": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_outputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "p0_blockers": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "skill_trust_levels": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "requires"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "requires": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "skill_archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "keywords", "default_trust", "purpose", "inputs", "outputs", "evals"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "keywords": {
            "type": "array",
            "items": { "type": "string" }
          },
          "default_trust": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "inputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "outputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evals": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "domain_skill_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "keywords", "recommended_skills", "required_disciplines"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "keywords": {
            "type": "array",
            "items": { "type": "string" }
          },
          "recommended_skills": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_disciplines": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
