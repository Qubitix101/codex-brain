{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-brain.local/schemas/project-state.schema.json",
  "title": "Codex Brain Project State",
  "type": "object",
  "required": [
    "project",
    "mode",
    "phase",
    "phase_status",
    "gates",
    "design_dna",
    "project_context",
    "distillates",
    "context",
    "current_task",
    "lessons"
  ],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["light", "standard", "full", "pending"] },
    "phase": {
      "enum": [
        "classify",
        "validate",
        "research",
        "agentic-opportunity",
        "intelligence-architecture",
        "agent-engineering",
        "agent-os-runtime",
        "capability-access",
        "plan",
        "design-dna",
        "decompose",
        "execute",
        "review",
        "ship",
        "learn"
      ]
    },
    "phase_status": { "enum": ["not-started", "in-progress", "blocked", "complete"] },
    "gates": {
      "type": "object",
      "properties": {
        "classification": { "$ref": "#/$defs/gate" },
        "validation": { "$ref": "#/$defs/gate" },
        "research": { "$ref": "#/$defs/gate" },
        "agentic_opportunity": { "$ref": "#/$defs/gate" },
        "intelligence_architecture": { "$ref": "#/$defs/gate" },
        "agent_engineering": { "$ref": "#/$defs/gate" },
        "agent_os_runtime": { "$ref": "#/$defs/gate" },
        "capability_access": { "$ref": "#/$defs/gate" },
        "plan": { "$ref": "#/$defs/gate" },
        "design_dna": { "$ref": "#/$defs/gate" },
        "decomposition": { "$ref": "#/$defs/gate" },
        "execution": { "$ref": "#/$defs/gate" },
        "review": { "$ref": "#/$defs/gate" },
        "ship": { "$ref": "#/$defs/gate" },
        "learn": { "$ref": "#/$defs/gate" }
      },
      "additionalProperties": { "$ref": "#/$defs/gate" }
    },
    "design_dna": {
      "type": "object",
      "required": ["required", "status", "frontend_unblocked"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "enum": ["not-required", "missing", "in-progress", "approved"] },
        "references_collected": { "type": "boolean" },
        "tokens_approved": { "type": "boolean" },
        "motion_direction": { "type": "string" },
        "frontend_unblocked": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "project_context": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "status": { "enum": ["missing", "draft", "current", "stale"] },
        "last_updated": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "distillates": {
      "type": "object",
      "properties": {
        "project": { "type": ["string", "null"] },
        "research": { "type": ["string", "null"] },
        "agentic_opportunity": { "type": ["string", "null"] },
        "intelligence_system": { "type": ["string", "null"] },
        "intelligence_architecture": { "type": ["string", "null"] },
        "agent_engineering": { "type": ["string", "null"] },
        "agent_os_runtime": { "type": ["string", "null"] },
        "skill_inventory": { "type": ["string", "null"] },
        "capability_access": { "type": ["string", "null"] },
        "build_plan": { "type": ["string", "null"] },
        "execution": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "properties": {
        "last_session_id": { "type": ["string", "null"] },
        "last_session_path": { "type": ["string", "null"] },
        "last_saved_at": { "type": ["string", "null"] },
        "last_summary": { "type": ["string", "null"] },
        "last_next_action": { "type": ["string", "null"] },
        "last_context_health_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "last_context_health_ok": { "type": ["boolean", "null"] },
        "unsaved_changes": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "current_task": {
      "type": "object",
      "properties": {
        "id": { "type": ["string", "null"] },
        "prd": { "type": ["string", "null"] },
        "claimed_by": { "type": ["string", "null"] },
        "claimed_at": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "lessons": {
      "type": "object",
      "properties": {
        "captured_count": { "type": "integer", "minimum": 0 },
        "promotion_candidates": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["status", "required_artifacts", "missing", "approved"],
      "properties": {
        "status": { "enum": ["not-started", "in-progress", "blocked", "complete"] },
        "required_artifacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing": {
          "type": "array",
          "items": { "type": "string" }
        },
        "approved": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
