{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-brain.local/schemas/agent-os-runtime-catalog.schema.json",
  "title": "Codex Brain Agent OS Runtime Catalog",
  "type": "object",
  "required": ["version", "principle", "kernel_components", "domain_runtime_patterns"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "principle": { "type": "string", "minLength": 1 },
    "kernel_components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/kernel_component" }
    },
    "domain_runtime_patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/domain_runtime_pattern" }
    }
  },
  "$defs": {
    "kernel_component": {
      "type": "object",
      "required": ["id", "name", "purpose", "keywords", "required_outputs", "p0_blockers"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_outputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "p0_blockers": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "domain_runtime_pattern": {
      "type": "object",
      "required": ["id", "name", "keywords", "recommended_components", "first_runtime_slice"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommended_components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "first_runtime_slice": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
